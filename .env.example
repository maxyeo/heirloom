# Copy to .env.local and fill in. Never commit .env.local.

# --- Database -----------------------------------------------------------
# The database a developer is expected to be pointing at day to day: a local
# Postgres, not the deployed one. Create it once with:
#   createdb heirloom
# and there is nothing else to configure — postgres.js defaults the user to
# your OS user, and a local Homebrew/Postgres.app install accepts local
# connections with no password.
DATABASE_URL="postgresql://localhost:5432/heirloom"

# The database `npm run test:db` writes to. A separate database from
# DATABASE_URL above, so the test suite's inserts and deletes never touch
# whatever you're using the app against day to day. Create it the same way:
#   createdb heirloom_test
# Selected via DATABASE_TARGET=test, which the `test:db` and
# `db:migrate:test` npm scripts already set — you should not need to set
# DATABASE_TARGET by hand for this one.
TEST_DATABASE_URL="postgresql://localhost:5432/heirloom_test"

# The deployed database. Heirloom deploys to Supabase, and this is that
# project's *pooler* connection string (port 6543, "Transaction" mode) — not
# the direct connection, which serverless functions would exhaust the
# connection limit of. Reach it deliberately with DATABASE_TARGET=production,
# e.g. `DATABASE_TARGET=production npm run db:studio`, without ever editing
# DATABASE_URL above to point at it.
#
# This is real production data. Anything that can delete rows (db/seed.ts)
# refuses to run against it unless SEED_ALLOW_DESTRUCTIVE names the exact
# user@host pair the connection uses — hostname alone is not enough to
# identify a project on Supabase's shared pooler, where the project lives in
# the username (postgres.<project-ref>), not the host. See README.md. Treat
# this value like a password.
# PRODUCTION_DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Migrations only, and only in a deployed environment. The transaction pooler
# above is the wrong connection for DDL — a different backend per transaction,
# no prepared statements. Point this at Supabase's *session* pooler or the
# direct connection (port 5432), in the deploy environment's own variables.
# Left unset, migrations fall back to DATABASE_URL (as resolved by
# DATABASE_TARGET, if set), which is what you want locally and on any plain
# Postgres.
# MIGRATE_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# --- Auth ---------------------------------------------------------------
# Generate with: npx auth secret
# This signs session cookies. Anyone who has it can forge a session as any
# allowed user, so treat it like a password and never paste it into an issue.
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:3001/api/auth/callback/google
# (and https://your-domain/api/auth/callback/google in production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Access control -----------------------------------------------------
# Comma-separated. Google sign-in proves *who* someone is; it has no opinion
# on whether they are allowed in. This list is the entire membership model.
# Anyone not listed is rejected at the door.
ALLOWED_EMAILS="you@example.com,someone-else@example.com"

# --- Storage ------------------------------------------------------------
# Image storage, and the only part of this application that is tied to a
# particular host. It reaches the code through exactly one module —
# `lib/storage.ts` — so this is a `STORAGE_*` variable rather than a
# `BLOB_*` or `VERCEL_*` one, for the same reason the database is
# `DATABASE_URL` and not `SUPABASE_URL`: the name describes what the app
# needs, not who happens to be providing it. Moving to S3, R2 or a directory
# on disk changes what goes in this variable and one file, and nothing else.
#
# On Vercel: Storage -> Blob -> your store -> the read-write token. Vercel's
# own integration also injects `BLOB_READ_WRITE_TOKEN` into the environment;
# it is deliberately not read here, since depending on it would put a
# vendor's variable name back into the deploy config it was just taken out
# of. Copy the value into STORAGE_TOKEN.
#
# It grants write and delete on the store, so treat it like a password.
# Nothing needs it until image upload exists (E5-T2); leaving it unset costs
# a readable error at the first upload and nothing before that.
# STORAGE_TOKEN=""

# --- Branding -----------------------------------------------------------
NEXT_PUBLIC_SITE_TITLE="Heirloom"
